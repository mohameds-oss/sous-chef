DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional: set RESEND_API_KEY (https://resend.com) to send real emails for
# signup verification / password reset. Without it, emails are stored in the
# DevEmail table and viewable at /dev/inbox.
RESEND_API_KEY=""
EMAIL_FROM="Sous-Chef <onboarding@resend.dev>"

# Set to your deployed URL in production so email links point at the right
# place (defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
