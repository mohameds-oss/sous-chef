// Prisma schema for Sous-Chef.
// SQLite for local/demo use; swap datasource provider to "postgresql" and
// DATABASE_URL for serverless deployment — models are portable as-is.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  hashedPassword String
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  savedRecipes        SavedRecipe[]
  mealPlanEntries     MealPlanEntry[]
  cookingProgress     CookingProgress[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  folder    String   @default("All Recipes")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model MealPlanEntry {
  id        String    @id @default(cuid())
  userId    String
  day       DayOfWeek
  mealType  MealType
  recipeId  String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, mealType])
  @@index([userId])
}

model DevEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

model CookingProgress {
  id          String   @id @default(cuid())
  userId      String
  recipeId    String
  currentStep Int      @default(0)
  servingsMul Float    @default(1)
  unitSystem  String   @default("us")
  completedAt DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}
